<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FDF6E3"> <!-- רקע קרמי תואם לאפליקציה -->

    <!-- לוגו האפליקציה למעלה -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/logo"
        android:layout_marginBottom="40dp"
        android:contentDescription="לוגו האפליקציה" />

    <!-- שדה שם משתמש -->
    <EditText
        android:id="@+id/et_username"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@android:color/white"
        android:hint="שם משתמש"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:inputType="text"
        android:textColorHint="#A0A0A0"
        android:elevation="2dp" />

    <!-- שדה סיסמה (מוסתר) -->
    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@android:color/white"
        android:hint="סיסמה"
        android:padding="12dp"
        android:layout_marginBottom="24dp"
        android:inputType="textPassword"
        android:textColorHint="#A0A0A0"
        android:elevation="2dp" />

    <!-- כפתור כניסה תואם למותג -->
    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="כניסה"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="#B74B00"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <!-- קישור להרשמה -->
    <TextView
        android:id="@+id/tv_register_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="אין לך חשבון? הירשמי כאן"
        android:textColor="#8D5524"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>